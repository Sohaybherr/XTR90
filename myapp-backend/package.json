{
  "name": "myapp-backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "test": "python -m unittest discover tests && node --test tests/*.test.js",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "transfermarkt:sync": "python scripts/sync_transfermarkt.py",
    "transfermarkt:transfers:sync": "python scripts/sync_transfermarkt_transfers.py",
    "transfers:sync": "python -m scripts.api_football.sync.sync_transfers",
    "rankings:sync": "python -m scripts.api_football.sync.sync_team_rankings",
    "transfermarkt:sync:all": "powershell -ExecutionPolicy Bypass -File scripts/run_transfermarkt_full_sync.ps1 -SleepSeconds 0.7",
    "transfermarkt:resume": "powershell -ExecutionPolicy Bypass -File scripts/run_transfermarkt_full_sync.ps1 -SleepSeconds 0.7",
    "transfermarkt:sync:all:bg": "powershell -ExecutionPolicy Bypass -File scripts/run_transfermarkt_full_sync.ps1",
    "api:international:plan": "python -m scripts.api_football.sync.backfill_international_2014_now",
    "api:international:sync": "python -m scripts.api_football.sync.backfill_international_2014_now --execute --from-season 2014 --to-season 2026 --max-requests 1000 --request-delay 0.1",
    "api:international:details": "python -m scripts.api_football.sync.backfill_international_2014_now --execute --phase match-details --from-season 2014 --to-season 2026 --max-requests 1000 --request-delay 0.1",
    "api:top5-cups:plan": "python -m scripts.api_football.sync.backfill_top5_cups_2015_2026",
    "api:top5-cups:sync": "python -m scripts.api_football.sync.backfill_top5_cups_2015_2026 --execute --phase core --from-season 2015 --to-season 2026 --max-requests 1000 --request-delay 0.1",
    "api:top5-cups:details": "python -m scripts.api_football.sync.backfill_top5_cups_2015_2026 --execute --phase match-details --from-season 2015 --to-season 2026 --max-requests 1000 --request-delay 0.1",
    "api:top5-cups:details:fa": "python -m scripts.api_football.sync.backfill_top5_cups_2015_2026 --execute --phase match-details --cup fa-cup --from-season 2015 --to-season 2026 --max-requests 1000 --request-delay 0.1",
    "api:top5-cups:details:copa": "python -m scripts.api_football.sync.backfill_top5_cups_2015_2026 --execute --phase match-details --cup copa-del-rey --from-season 2015 --to-season 2026 --max-requests 1000 --request-delay 0.1",
    "api:top5-cups:details:coppa": "python -m scripts.api_football.sync.backfill_top5_cups_2015_2026 --execute --phase match-details --cup coppa-italia --from-season 2015 --to-season 2026 --max-requests 1000 --request-delay 0.1",
    "api:top5-cups:details:dfb": "python -m scripts.api_football.sync.backfill_top5_cups_2015_2026 --execute --phase match-details --cup dfb-pokal --from-season 2015 --to-season 2026 --max-requests 1000 --request-delay 0.1",
    "api:top5-cups:details:coupe": "python -m scripts.api_football.sync.backfill_top5_cups_2015_2026 --execute --phase match-details --cup coupe-de-france --from-season 2015 --to-season 2026 --max-requests 1000 --request-delay 0.1",
    "api:missing:plan": "python -m scripts.api_football.sync.backfill_missing_data",
    "api:missing:sync": "python -m scripts.api_football.sync.backfill_missing_data --execute --request-delay 0.1 --ignore-budget",
    "api:competitions:latest": "python -m scripts.api_football.sync.sync_competitions_latest",
    "api:competitions:latest:full": "python -m scripts.api_football.sync.sync_competitions_latest_full",
    "api:missing:images": "python -m scripts.api_football.sync.backfill_missing_data --execute --phase images",
    "api:missing:details": "python -m scripts.api_football.sync.backfill_missing_data --execute --phase match-details --request-delay 0.1 --ignore-budget",
    "api:clubs:squads": "python -m scripts.api_football.sync.backfill_missing_data --execute --phase club-squads --request-delay 0.1 --ignore-budget",
    "api:clubs:squads:all-seasons": "python -m scripts.api_football.sync.backfill_missing_data --execute --phase club-squads --all-seasons --request-delay 0.1 --ignore-budget",
    "api:squads:changed": "python -m scripts.api_football.sync.sync_changed_team_squads",
    "api:friendlies:sync": "python -m scripts.api_football.sync.sync_summer_friendlies",
    "live:once": "python -m scripts.api_football.live.live_scheduler --limit 50 --ignore-budget",
    "live:watch": "python -m scripts.api_football.live.live_scheduler --limit 50 --ignore-budget --watch --interval 3",
    "live:match": "powershell -ExecutionPolicy Bypass -File scripts/run_live_match_sync.ps1 -IntervalSeconds 5 -IgnoreBudget",
    "matches:sync:date": "python scripts/sync_matches_for_date.py",
    "odds:sync": "python scripts/sync_odds.py --live",
    "odds:watch": "python scripts/sync_odds.py --live --watch --interval 10800",
    "odds:live": "python scripts/sync_odds.py --live-only --watch --interval 60"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "gr": "^0.0.1",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
